syntax = "v1"

info (
	title:   "AI Chat Bot API"
	desc:    "微信小程序 AI 聊天机器人后端接口"
	author:  "your-name"
	email:   "your-email@example.com"
	version: "v1"
)

// ============== 基础数据结构 ==============
type (
	// Bot 信息
	BotInfo {
		BotId                   string         `json:"botId"`
		Name                    string         `json:"name"`
		Avatar                  string         `json:"avatar"`
		WelcomeMessage          string         `json:"welcomeMessage"`
		InitQuestions           []string       `json:"initQuestions"`
		IsNeedRecommend         bool           `json:"isNeedRecommend"`
		MultiConversationEnable bool           `json:"multiConversationEnable"`
		SearchEnable            bool           `json:"searchEnable"`
		SearchFileEnable        bool           `json:"searchFileEnable"`
		VoiceSettings           *VoiceSettings `json:"voiceSettings,omitempty"`
	}
	// 语音设置
	VoiceSettings {
		Enable     bool   `json:"enable"`
		InputType  string `json:"inputType"`
		OutputType string `json:"outputType"`
	}
	// 文件信息
	FileInfo {
		FileId   string `json:"fileId"`
		FileName string `json:"fileName"`
		Type     string `json:"type"`
		Bytes    int64  `json:"bytes"`
		CloudId  string `json:"cloudId"`
	}
	// 搜索结果
	SearchResult {
		Title string `json:"title"`
		Url   string `json:"url"`
	}
	// 搜索信息
	SearchInfo {
		SearchResults []SearchResult `json:"search_results"`
	}
	// 工具调用
	ToolCall {
		Id       string           `json:"id"`
		Type     string           `json:"type"`
		Function ToolCallFunction `json:"function"`
	}
	ToolCallFunction {
		Name      string                 `json:"name"`
		Arguments map[string]interface{} `json:"arguments"`
	}
	// 聊天记录
	ChatRecord {
		RecordId   string     `json:"recordId"`
		Role       string     `json:"role"` // user/assistant
		Content    string     `json:"content"`
		FileInfos  []FileInfo `json:"fileInfos,omitempty"`
		CreateTime string     `json:"createTime"`
		UpdateTime string     `json:"updateTime"`
		TraceId    string     `json:"trace_id,omitempty"`
		OriginMsg  string     `json:"origin_msg,omitempty"`
	}
	// 会话信息
	ConversationInfo {
		ConversationId string `json:"conversationId"`
		Title          string `json:"title"`
		CreateTime     string `json:"createTime"`
		UpdateTime     string `json:"updateTime"`
		IsDefault      bool   `json:"isDefault"`
	}
)

// ============== 请求/响应结构 ==============
type (
	// 获取Bot信息
	GetBotReq {
		BotId string `path:"botId"`
	}
	GetBotResp {
		Code    int    `json:"code"`
		Message string `json:"message"`
		BotInfo // 直接嵌入BotInfo
	}
	// 发送消息请求
	SendMessageReq {
		BotId          string   `json:"botId"`
		Msg            string   `json:"msg"`
		Files          []string `json:"files,omitempty"`
		SearchEnable   bool     `json:"searchEnable,omitempty"`
		ConversationId string   `json:"conversationId,omitempty"`
	}
	// 流式响应数据结构
	StreamEvent {
		Type             string                 `json:"type"` // search/thinking/text/tool-call/tool-result/knowledge/db/finish
		Content          string                 `json:"content,omitempty"`
		ReasoningContent string                 `json:"reasoning_content,omitempty"`
		RecordId         string                 `json:"record_id,omitempty"`
		SearchInfo       *SearchInfo            `json:"search_info,omitempty"`
		Role             string                 `json:"role,omitempty"`
		KnowledgeMeta    []interface{}          `json:"knowledge_meta,omitempty"`
		KnowledgeBase    []interface{}          `json:"knowledge_base,omitempty"`
		FinishReason     string                 `json:"finish_reason,omitempty"`
		SearchResults    *SearchResults         `json:"search_results,omitempty"`
		Error            *ErrorInfo             `json:"error,omitempty"`
		Usage            *Usage                 `json:"usage,omitempty"`
		ToolCall         *ToolCall              `json:"tool_call,omitempty"`
		ToolCallId       string                 `json:"toolCallId,omitempty"`
		Result           map[string]interface{} `json:"result,omitempty"`
		CallResult       bool                   `json:"callResult,omitempty"` // 新增：标识工具调用是否完成
	}
	SearchResults {
		RelateTables int `json:"relateTables"`
	}
	ErrorInfo {
		Message interface{} `json:"message"`
	}
	Usage {
		CompletionTokens int `json:"completionTokens"`
	}
	// 获取聊天记录
	GetChatRecordsReq {
		BotId          string `form:"botId"`
		PageNumber     int    `form:"pageNumber,default=1"`
		PageSize       int    `form:"pageSize,default=10"`
		Sort           string `form:"sort,default=desc"`
		ConversationId string `form:"conversationId,omitempty"`
	}
	GetChatRecordsResp {
		RecordList []ChatRecord `json:"recordList"`
		Total      int          `json:"total"`
	}
	// 推荐问题
	GetRecommendQuestionsReq {
		BotId        string          `json:"botId"`
		History      []SimpleMessage `json:"history"`
		Msg          string          `json:"msg"`
		AgentSetting string          `json:"agentSetting"`
		Introduction string          `json:"introduction"`
		Name         string          `json:"name"`
	}
	SimpleMessage {
		Role    string `json:"role"`
		Content string `json:"content"`
	}
	// 会话管理
	CreateConversationReq {
		BotId string `json:"botId"`
	}
	CreateConversationResp {
		ConversationId string `json:"conversationId"`
		Title          string `json:"title"`
	}
	GetConversationsReq {
		BotId     string `form:"botId"`
		Limit     int    `form:"limit,default=15"`
		Offset    int    `form:"offset,default=0"`
		IsDefault bool   `form:"isDefault,default=false"`
	}
	GetConversationsResp {
		Data  []ConversationInfo `json:"data"`
		Total int                `json:"total"`
	}
	// 语音相关
	SpeechToTextReq {
		BotId          string `path:"botId"`
		Url            string `json:"url"`
		EngSerViceType string `json:"engSerViceType"`
		VoiceFormat    string `json:"voiceFormat"`
	}
	SpeechToTextResp {
		Result string `json:"Result"`
	}
	TextToSpeechReq {
		BotId     string `path:"botId"`
		Text      string `json:"text,omitempty"`
		VoiceType string `json:"voiceType,omitempty"`
		TaskId    string `json:"taskId,omitempty"`
	}
	TextToSpeechResp {
		TaskId    string `json:"TaskId,omitempty"`
		Status    int    `json:"Status,omitempty"`
		ResultUrl string `json:"ResultUrl,omitempty"`
		Code      int    `json:"code,omitempty"`
	}
)

// ============== API 路由定义 ==============
@server (
	prefix: /api/v2
	group:  bot
)
service chat {
	// 获取Bot信息
	@handler getBotHandler
	get /bots/:botId (GetBotReq) returns (GetBotResp)

	// 发送消息 (WebSocket)
	@handler sendMessageHandler
	post /bots/sendMessage (SendMessageReq)

	// 获取聊天记录
	@handler getChatRecordsHandler
	get /bots/getChatRecords (GetChatRecordsReq) returns (GetChatRecordsResp)

	// 获取推荐问题 (WebSocket)
	@handler getRecommendQuestionsHandler
	post /bots/getRecommendQuestions (GetRecommendQuestionsReq)

	// 语音转文字
	@handler speechToTextHandler
	post /bots/:botId/speech-to-text (SpeechToTextReq) returns (SpeechToTextResp)

	// 文字转语音
	@handler textToSpeechHandler
	post /bots/:botId/text-to-speech (TextToSpeechReq) returns (TextToSpeechResp)

	// 获取文字转语音结果
	@handler getTextToSpeechHandler
	get /bots/:botId/text-to-speech (TextToSpeechReq) returns (TextToSpeechResp)
}

@server (
	prefix: /api/v2
	group:  conversation
)
service chat {
	// 创建会话
	@handler createConversationHandler
	post /conversation (CreateConversationReq) returns (CreateConversationResp)

	// 获取会话列表
	@handler getConversationsHandler
	get /conversation (GetConversationsReq) returns (GetConversationsResp)
}

// WebSocket 路由 (需要单独处理)
@server (
	//prefix: /ws
	group: websocket
)
service chat {
	// WebSocket连接端点
	@handler websocketHandler
	get /chat
}

